# Disable LiteSpeed Server-Side Cache for dynamic React SPA
<IfModule LiteSpeed>
  CacheLookup off
  CacheEngine off
</IfModule>

# Cache-Control headers for SPA
<IfModule mod_headers.c>
  # Never cache HTML so updates are immediate
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header set X-LiteSpeed-Purge "*"
  </FilesMatch>

  # Cache versioned static assets (Vite adds content hashes)
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# SPA Routing & Canonical Redirect
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect non-www to www
  RewriteCond %{HTTP_HOST} ^omaanu\.com$ [NC]
  RewriteRule ^(.*)$ https://www.omaanu.com/$1 [L,R=301]

  # Send all other requests to index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

